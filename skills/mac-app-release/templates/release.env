# Release settings shared by scripts/release-build.sh and .github/workflows/release.yml.
# No secrets here: this file is committed.
APP_NAME="<APP_NAME>"          # product name, e.g. MyApp for MyApp.app and MyApp-1.2.3.zip
PROJECT="<PROJECT>"            # .xcodeproj path from the repo root
SCHEME="<SCHEME>"
TEAM_ID="<TEAM_ID>"
FEED="<FEED>"                  # public | private
# Optional: git-ignored xcconfig that CI recreates from the LOCAL_XCCONFIG secret.
# Must be the exact path a tracked xcconfig includes. Leave empty if unused.
LOCAL_XCCONFIG_PATH=""
